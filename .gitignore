*.env
*.pem
*.key
!docs/**/*.pem

# Footage never goes in git
recordings/
evidence/
*.mp4
*.mjpeg

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local IDE
.cursor/
