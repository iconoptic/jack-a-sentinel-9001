# Bash assignments, sourced by host/network/setup-ap.sh.
# The real file is secrets/ap.env (gitignored), created by
# host/scripts/generate-secrets.sh. host/network/install-ap.sh fills WIFI_IFACE, CHANNEL, WIFI_BSSID.
# CHANNEL is 1, 6, or 11 after a quiet-channel scan. See host/network/README.md.
# SSID must not contain SENTINEL. PSK is 8–63 characters.

WIFI_IFACE=REPLACE_ME
SSID=REPLACE_ME
PSK=REPLACE_ME
CHANNEL=REPLACE_ME
# BSSID from: iw dev "$WIFI_IFACE" info  (after setup-ap.sh)
WIFI_BSSID=REPLACE_ME
